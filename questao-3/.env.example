# Configuração da questão 3. Copie para .env e preencha a chave; o .env fica fora do git.

# Chave da API da OpenAI. Só a geração das consultas de avaliação usa: a busca roda sem ela.
# Gere em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelos que geram e rotulam as consultas de avaliação (uv run --env-file .env semantic-search-queries).
# O juiz é mais forte que o gerador: os rótulos de relevância são a régua de todos os experimentos.
EVAL_QUERY_MODEL=gpt-5.4-mini
EVAL_JUDGE_MODEL=gpt-5.4
