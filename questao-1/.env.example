# Configuração da API. Copie para .env e rode: uv run --env-file .env library
# Todas as variáveis são opcionais; os valores abaixo são os padrões.
# O .env fica fora do git: chaves e segredos futuros entram nele, nunca neste arquivo.

# Arquivo do banco SQLite.
LIBRARY_DATABASE_PATH=library.db

# Fuso da biblioteca: define o "hoje" que responde se um livro já está publicado (is_published).
LIBRARY_TIMEZONE=America/Sao_Paulo

# Rate limiting: requisições permitidas por cliente (IP) a cada janela de N segundos.
LIBRARY_RATE_LIMIT_REQUESTS=60
LIBRARY_RATE_LIMIT_WINDOW_SECONDS=60
