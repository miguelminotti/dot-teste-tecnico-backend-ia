# Configuração do chatbot. Copie para .env, preencha as chaves e rode: uv run --env-file .env chatbot
# O .env fica fora do git: as chaves entram só nele, nunca neste arquivo.

# Chave da API da OpenAI (obrigatória). Gere em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo da OpenAI que responde as perguntas, escolhido pelas avaliações (docs/adr/0002). O gpt-4.1-mini
# é a opção barata, sem busca: ele erra as perguntas sobre recursos recentes do Python.
CHATBOT_MODEL=gpt-5.4-mini

# Busca na documentação oficial antes de responder (true ou false). Pede um modelo que aceite o filtro de
# domínios da busca, como o gpt-5.4-mini: o gpt-4.1-mini recusa a chamada.
CHATBOT_DOCS_SEARCH=true

# LangSmith: registra cada turno (pergunta, resposta, tokens, custo e latência) e roda as avaliações.
# Gere a chave em https://smith.langchain.com, em Settings > API Keys.
# Sem chave do LangSmith, use LANGSMITH_TRACING=false: o chatbot funciona, só não registra os turnos.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dot-questao-2

# Modelo juiz das avaliações (uv run --env-file .env chatbot-eval). Mais forte e de outra geração que o
# do chatbot, para não favorecer o próprio estilo.
EVAL_JUDGE_MODEL=gpt-5.4
